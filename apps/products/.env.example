# HTTP server
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed origins for CORS (the web app)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:root@localhost:5433/product_creator

# RabbitMQ connection string
RABBITMQ_URL=amqp://app:app@localhost:5672
